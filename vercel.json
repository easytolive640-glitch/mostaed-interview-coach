{
  "version": 2,
  "functions": {
    "api/evaluate.mjs": {
      "maxDuration": 60
    },
    "api/account-config.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/coaching",
      "destination": "/api/account-config?coaching=1"
    },
    {
      "source": "/api/paypal-sandbox-webhook",
      "destination": "/api/paypal-webhook?sandbox=1"
    },
    {
      "source": "/v1/evaluate",
      "destination": "/api/evaluate"
    }
  ],
  "headers": [
    {
      "source": "/account.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/history.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paid-practice.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/checkout-test.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v1/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
