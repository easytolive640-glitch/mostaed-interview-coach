{
  "version": 2,
  "functions": {
    "api/evaluate.mjs": {
      "maxDuration": 60
    },
    "api/account-config.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/freepractice",
      "destination": "/freepractice.html"
    },
    {
      "source": "/freepractice/releases/:release/:path*",
      "destination": "https://easytolive640-glitch.github.io/mostaed-interview-coach/:path*"
    },
    {
      "source": "/freepractice/:path*",
      "destination": "https://easytolive640-glitch.github.io/mostaed-interview-coach/:path*"
    },
    {
      "source": "/api/support",
      "destination": "/api/account-config?support=1"
    },
    {
      "source": "/api/admin",
      "destination": "/api/account-config?admin=1"
    },
    {
      "source": "/api/coaching",
      "destination": "/api/account-config?coaching=1"
    },
    {
      "source": "/api/paypal-sandbox-webhook",
      "destination": "/api/paypal-webhook?sandbox=1"
    },
    {
      "source": "/v1/evaluate",
      "destination": "/api/evaluate"
    }
  ],
  "headers": [
    {
      "source": "/account.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/history.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paid-practice.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/checkout-test.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v1/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/freepractice",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/freepractice/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/freepractice.html",
      "destination": "/freepractice",
      "permanent": true
    },
    {
      "source": "/freepractice/",
      "destination": "/freepractice",
      "permanent": true
    },
    {
      "source": "/blogs/cv-achievements.html",
      "destination": "https://www.themuse.com/advice/professional-accomplishments-achievements-on-resume-examples",
      "permanent": true
    },
    {
      "source": "/blogs/prepare-for-your-interview.html",
      "destination": "https://www.themuse.com/advice/second-interview-questions-answers-examples",
      "permanent": true
    },
    {
      "source": "/blogs/30-day-career-plan.html",
      "destination": "https://www.themuse.com/advice/8-steps-to-an-utterly-successful-career-change",
      "permanent": true
    }
  ]
}
